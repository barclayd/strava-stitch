{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strava-stitch",
  "main": "worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "npm run build:assets",
    "watch_dir": ["app", "public", "scripts"],
  },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:44100",
    "STRAVA_CLIENT_ID": "262735",
    "STRAVA_WEBHOOK_SUBSCRIPTION_ID": "",
  },
  "secrets": {
    "required": [
      "STRAVA_CLIENT_SECRET",
      "SESSION_SECRET",
      "TOKEN_ENCRYPTION_KEY",
      "STRAVA_WEBHOOK_VERIFY_TOKEN",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ATHLETES",
        "class_name": "AthleteData",
      },
      {
        "name": "SESSIONS",
        "class_name": "BrowserSession",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AthleteData", "BrowserSession"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1,
    },
  },
  "env": {
    "staging": {
      "name": "strava-stitch-staging",
      "vars": {
        "APP_ORIGIN": "https://staging.stravastitch.com",
        "STRAVA_CLIENT_ID": "262735",
        "STRAVA_WEBHOOK_SUBSCRIPTION_ID": "",
      },
      "secrets": {
        "required": [
          "STRAVA_CLIENT_SECRET",
          "SESSION_SECRET",
          "TOKEN_ENCRYPTION_KEY",
          "STRAVA_WEBHOOK_VERIFY_TOKEN",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ATHLETES",
            "class_name": "AthleteData",
          },
          {
            "name": "SESSIONS",
            "class_name": "BrowserSession",
          },
        ],
      },
      "routes": [
        {
          "pattern": "staging.stravastitch.com",
          "custom_domain": true,
        },
      ],
      "workers_dev": false,
    },
    "production": {
      "name": "strava-stitch",
      "vars": {
        "APP_ORIGIN": "https://stravastitch.com",
        "STRAVA_CLIENT_ID": "262735",
        "STRAVA_WEBHOOK_SUBSCRIPTION_ID": "371550",
      },
      "secrets": {
        "required": [
          "STRAVA_CLIENT_SECRET",
          "SESSION_SECRET",
          "TOKEN_ENCRYPTION_KEY",
          "STRAVA_WEBHOOK_VERIFY_TOKEN",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ATHLETES",
            "class_name": "AthleteData",
          },
          {
            "name": "SESSIONS",
            "class_name": "BrowserSession",
          },
        ],
      },
      "routes": [
        {
          "pattern": "stravastitch.com",
          "custom_domain": true,
        },
      ],
      "workers_dev": false,
    },
  },
  "account_id": "3343118697a4beccae42090c4520cd29",
}
