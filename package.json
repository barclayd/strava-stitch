{
  "name": "stitch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check app server.ts hmr.ts public/styles.css package.json"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "remix": "^3.0.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prettier": "^3.9.6",
    "typescript": "latest"
  }
}
