{
  "name": "stitch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 44100",
    "build:assets": "node scripts/build-assets.ts",
    "build": "wrangler deploy --env production --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy --env production",
    "test": "NODE_ENV=test node --import remix/node-tsx --test --test-concurrency=1",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface Env --include-runtime false && prettier --write worker-configuration.d.ts",
    "format": "prettier --check app scripts worker.ts worker-configuration.d.ts wrangler.jsonc tsconfig.json public/styles.css package.json"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "remix": "^3.0.0-rc.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.2",
    "typescript": "latest",
    "wrangler": "^4.129.0"
  }
}
